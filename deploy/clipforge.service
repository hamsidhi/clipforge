[Unit]
Description=ClipForge server (web app, publishing scheduler, Telegram bot, worker coordinator)
After=network-online.target ollama.service tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=clipforge
Group=clipforge
WorkingDirectory=/opt/clipforge/app
Environment=PYTHONUNBUFFERED=1
# listens on localhost only; `tailscale serve` publishes it to your tailnet over HTTPS — never to the internet
ExecStart=/opt/clipforge/app/.venv/bin/clipforge ui --host 127.0.0.1 --port 8000 --no-browser
Restart=on-failure
RestartSec=10
# hardening (no NoNewPrivileges: `clipforge server update` uses one narrow sudo rule to restart itself)
UMask=0077
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/clipforge
# Ampere cores have no SMT: one thread per core is right for Whisper / ffmpeg
Nice=5

[Install]
WantedBy=multi-user.target
